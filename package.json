{
  "name": "avs-todos",
  "displayName": "AVS Todos",
  "description": "A project-based task manager that stores data locally in 'avstodos' file.",
  "version": "1.0.0",
  "publisher": "ahmetveysel",
  "icon": "media/icon.svg",
  
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "avs-todos-sidebar",
          "title": "AVS Todos",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "avs-todos-sidebar": [
        {
          "type": "webview",
          "id": "avs-todos-view",
          "name": "Task List",
          "icon": "media/icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/vscode": "^1.120.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3"
  }
}
