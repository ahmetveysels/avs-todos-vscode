{
  "name": "avs-todos",
  "displayName": "AVS Sidebar Todos",
  "description": "A project-based task manager that stores data locally in 'avstodos' file.",
  "version": "1.0.3",
  "publisher": "ahmetveysel",
  "icon": "media/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmetveysels/avs-todos-vscode.git"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],

  "keywords": [
    "todo",
    "todo list",
    "list",
    "todofy",
    "task",
    "task manager",
    "productivity",
    "checklist",
    "sidebar todo",
    "project-based todo",
    "local storage todo",
    "avstodos"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "avs-todos-sidebar",
          "title": "AVS Sidebar Todos",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "avs-todos-sidebar": [
        {
          "type": "webview",
          "id": "avs-todos-view",
          "name": "Task List",
          "icon": "media/icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/vscode": "^1.120.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3"
  }
}
